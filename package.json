  "description": "Chairlyos Web Automation with Selenium WebDriver and TypeScript",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test:login": "cross-env HEADLESS=false ts-node --esm tests/login.ts",
    "test:branch": "cross-env HEADLESS=false ts-node --esm tests/branch.crud.ts",
    "test:headless": "cross-env HEADLESS=true ts-node --esm tests/branch.crud.ts",
    "headed": "cross-env HEADLESS=false ts-node --esm",
    "headless": "cross-env HEADLESS=true ts-node --esm"
  },
  "keywords": [],
